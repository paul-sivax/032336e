# Local demo: no partner credentials, real funds, or LLM required.
PAYMENT_MODE=mock
RISK_MODE=off
DEMO_ACCESS_KEY=local-demo-only
SERVICE_KEY=local-service-only
MOCK_PAYMENT_SECRET=local-mock-only
DATA_DIR=.demo-data
PUBLIC_API_URL=http://localhost:8010
PUBLIC_WEB_URL=http://localhost:5173
ORDERS_URL=http://127.0.0.1:8012
RFQ_FEE_DROPS=1000
ORDER_FEE_DROPS=5000
# Testnet only. Generate dedicated faucet-funded accounts; never use production seeds.
XRPL_NETWORK=xrpl:1
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
XRPL_PAYER_SEED=
XRPL_PAY_TO=
# Required for actual Testnet orders. Dedicated wallets, separate from the x402 payer.
# Run scripts/setup_mpt_testnet.py to upgrade an existing Testnet profile.
XRPL_MPT_ISSUER_SEED=
XRPL_MPT_HOLDER_SEED=
# Private random 32-byte AES key, base64 encoded. Back it up; never put it in VITE_*.
MPT_METADATA_KEY=
MPT_METADATA_KEY_ID=k1
# Optional historical keys for decrypting receipts after rotation; private server-side JSON.
# MPT_METADATA_KEYS_JSON={}
# Hosted testnet facilitator currently requires its documented analytics SourceTag.
# This is not a universal x402 constant; use your facilitator's configured tag.
XRPL_SOURCE_TAG=804681468
# Optional independent LLM agent (OpenAI-compatible Chat Completions API).
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model
# LLM_API_KEY=
# SIVAX_AGENT_TOKEN=
